<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="view_product_spec_value_form">
            <field name="name">Product Specification Value</field>
            <field name="model">product.spec.value</field>
            <field name="arch" type="xml">
                <form string="Product Specification Value">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="sequence" invisible="1" />
                            </group>
                            <group>
                                <field name="spec_id" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="view_product_spec_value_tree">
            <field name="name">Product Specification Value</field>
            <field name="model">product.spec.value</field>
            <field name="arch" type="xml">
                <list string="Product Specification Value">
                    <field name="sequence" widget="handle" />
                    <field name="name" />
                    <field name="spec_id" />
                </list>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_product_spec_value_form">
            <field name="name">Product Specification Value</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.spec.value</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new barcode nomenclature
                </p>
                <p>
                    A barcode nomenclature defines how the point of sale identify and interprets
                    barcodes
                </p>
            </field>
        </record>
        <menuitem id="menu_product_spec_value" action="action_product_spec_value_form" parent="sale.prod_config_main" sequence="32"/>
    </data>
</odoo>