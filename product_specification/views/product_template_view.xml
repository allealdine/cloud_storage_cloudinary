        -->
        <record id="product_template_spec_line_form" model="ir.ui.view">
            <field name="name">product.spec.line.form</field>
            <field name="model">product.spec.line</field>
            <field name="mode">primary</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <form string="Product Specification">
                    <group name="main_field">
                        <group>
                            <field name="spec_id" />
                            <field name="categ_id" />
                        </group>
                        <group>
                            <field name="value_id" />
                        </group>
                    </group>
                    <field name="note" />
                </form>
            </field>
        </record>
    </data>
</odoo>